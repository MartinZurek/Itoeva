# ---- Build-Ergebnisse ----
# Werden bei jedem Bauen neu erzeugt und sind zusammen hunderte Megabyte gross.
build/
.gradle/
.cxx/
.externalNativeBuild/

# ---- Lokale generierte Medien ----
# API-Ausgaben werden zuerst hier erzeugt und nur ueber den Musik-Workflow gezielt als
# geprueftes App-Asset in einen eigenen PR uebernommen.
generated/music/

# ---- Maschinenspezifisch ----
# Enthaelt den SDK-Pfad DIESES Rechners und gehoert deshalb niemandem sonst.
local.properties

# ---- Fertige App-Pakete ----
# Ergebnisse, keine Quellen. Sie liegen hier nur zum Weitergeben.
*.apk
*.aab

# ---- Signaturmaterial ----
# Der Schluesselspeicher und die Zugangsdaten dazu. Wer sie hat, kann Updates unter deinem
# Namen auf fremde Geraete schieben - sie gehoeren in einen Passwortmanager und in die
# GitHub Secrets, niemals in die Historie. Die Vorlage `keystore.properties.example` bleibt
# eingecheckt; sie enthaelt nur Platzhalter.
keystore.properties
*.jks
*.keystore

# ---- Entwicklungsumgebung ----
.idea/
*.iml
.DS_Store

# Zwischenergebnisse des Kotlin-Compilers
.kotlin/

# ---- Arbeitsverzeichnis der Offline-Werkzeuge ----
# `tools/reaction-preview/*.sh` legen hier den geholten Kotlin-Compiler (~80 MB), JUnit und
# ihre uebersetzten Klassen ab. Alles davon ist nachladbar und gehoert nicht in die Historie.
# Stand bisher nicht hier, weil die Werkzeuge nie im Repository selbst ausgefuehrt wurden.
tools/reaction-preview/.work/
