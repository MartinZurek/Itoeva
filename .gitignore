# ---- Build-Ergebnisse ----
# Werden bei jedem Bauen neu erzeugt und sind zusammen hunderte Megabyte gross.
build/
.gradle/
.cxx/
.externalNativeBuild/

# ---- Maschinenspezifisch ----
# Enthaelt den SDK-Pfad DIESES Rechners und gehoert deshalb niemandem sonst.
local.properties

# ---- Fertige App-Pakete ----
# Ergebnisse, keine Quellen. Sie liegen hier nur zum Weitergeben.
*.apk
*.aab

# ---- Signaturmaterial ----
# Der Schluesselspeicher und die Zugangsdaten dazu. Wer sie hat, kann Updates unter deinem
# Namen auf fremde Geraete schieben - sie gehoeren in einen Passwortmanager und in die
# GitHub Secrets, niemals in die Historie. Die Vorlage `keystore.properties.example` bleibt
# eingecheckt; sie enthaelt nur Platzhalter.
keystore.properties
*.jks
*.keystore

# ---- Entwicklungsumgebung ----
.idea/
*.iml
.DS_Store

# Zwischenergebnisse des Kotlin-Compilers
.kotlin/
