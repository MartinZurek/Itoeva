{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "findings", "baseSha", "treeOid", "testManifestHash", "contextHash"],
  "properties": {
    "status": { "enum": ["PASS", "FAIL"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message"],
        "properties": {
          "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "UNVERIFIED"] },
          "message": { "type": "string", "minLength": 1 },
          "path": { "type": "string" }
        }
      }
    },
    "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "treeOid": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "testManifestHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contextHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
