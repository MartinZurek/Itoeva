{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "baseSha", "title", "plan", "paths", "tests"],
  "properties": {
    "status": { "enum": ["PLANNED", "ABORTED"] },
    "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "plan": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
